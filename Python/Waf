"""
WAF Report Generator — Python replacement for the Office Script
--------------------------------------------------------------
USAGE:
    python waf_report.py

HOW IT WORKS:
    Step 1  — DailyReport   : paste your raw WAF log txt into a file called  raw_input.txt
                               in the same folder, then run the script.
                               It appends new data into WAF_Report.xlsx (creates it if needed).

    Step 2  — CreateRuleSheets : automatically runs after DailyReport.

    Step 3  — GenerateMonthlyReport : uncomment the call at the bottom when you are ready
                                       to produce the monthly pivot summary.

REQUIREMENTS:
    pip install openpyxl
"""

import re
import sys
from collections import defaultdict
from datetime import datetime, date
from pathlib import Path

import openpyxl
from openpyxl import Workbook, load_workbook
from openpyxl.styles import (
    Font, PatternFill, Alignment, Border, Side, numbers
)
from openpyxl.utils import get_column_letter

# ── file paths ────────────────────────────────────────────────────────────────
RAW_INPUT_FILE = "raw_input.txt"      # paste your daily raw WAF log here
OUTPUT_FILE    = "WAF_Report.xlsx"    # created/updated by the script

# ── colours (hex, no #) ───────────────────────────────────────────────────────
GREEN_HEADER = "70AD47"
GREEN_PIVOT  = "00B050"
BLACK        = "000000"
WHITE        = "FFFFFF"

# ── column widths (pixels → approximate openpyxl units: divide by 7) ─────────
COL_WIDTHS = {          # openpyxl width units
    "A": 14.4,          # Date        (≈100.5 px)
    "B": 24.5,          # Rule Set    (≈171.75 px)
    "C": 27.5,          # Rule        (≈192.75 px)
    "D": 25.8,          # URI         (≈180.5 px)
    "E": 44.1,          # Args        (≈308.75 px)
}
HEADERS = ["Date", "Rule Set", "Rule", "URI", "Args"]


# ══════════════════════════════════════════════════════════════════════════════
# HELPERS
# ══════════════════════════════════════════════════════════════════════════════

def thin_border():
    s = Side(style="thin", color=BLACK)
    return Border(left=s, right=s, top=s, bottom=s)


def apply_borders(ws, min_row, max_row, min_col, max_col):
    b = thin_border()
    for row in ws.iter_rows(min_row=min_row, max_row=max_row,
                             min_col=min_col, max_col=max_col):
        for cell in row:
            cell.border = b


def style_header_row(ws):
    """Green header row, bold, centred — matches Style_edit in the script."""
    fill = PatternFill("solid", fgColor=GREEN_HEADER)
    font = Font(bold=True, color=BLACK)
    align = Alignment(horizontal="center", vertical="center", wrap_text=True)
    b = thin_border()
    for col_idx, col_letter in enumerate("ABCDE", 1):
        cell = ws.cell(row=1, column=col_idx)
        cell.value = HEADERS[col_idx - 1]
        cell.fill  = fill
        cell.font  = font
        cell.alignment = align
        cell.border = b
        ws.column_dimensions[col_letter].width = COL_WIDTHS[col_letter]
    ws.row_dimensions[1].height = 21
    ws.freeze_panes = "A2"


def style_data_rows(ws, start_row=2):
    """Borders + wrap on all data rows."""
    b = thin_border()
    wrap = Alignment(wrap_text=True)
    for row in ws.iter_rows(min_row=start_row, max_row=ws.max_row,
                             min_col=1, max_col=5):
        for cell in row:
            cell.border    = b
            cell.alignment = wrap


def set_date_format(ws, col=1, start_row=2):
    """Apply dd/MM/yy hh:mm:ss number format to the date column."""
    fmt = "DD/MM/YY HH:MM:SS"
    for row in ws.iter_rows(min_row=start_row, max_row=ws.max_row,
                             min_col=col, max_col=col):
        for cell in row:
            if cell.value is not None:
                cell.number_format = fmt


def sanitise_sheet_name(name: str) -> str:
    """Remove Excel-illegal chars and cap at 31 characters."""
    cleaned = re.sub(r"[\[\]*?/\\:]", "", name).strip()
    return cleaned[:31]


# ══════════════════════════════════════════════════════════════════════════════
# STEP 1 — DailyReport  (parse raw_input.txt → ConsolidationSheet)
# ══════════════════════════════════════════════════════════════════════════════

EXPECTED_HEADER = (
    "timestamp|terminatingRuleId|action|httpSourceName|httpSourceId|"
    "ruleGroupId|ruleId|clientIp|country|PLMUsername|Host|uri|args|"
    "httpVersion|httpMethod"
)
# Raw pipe-column indices
IDX_TS  = 0
IDX_RG  = 5
IDX_RI  = 6
IDX_URI = 11
IDX_ARG = 12


def parse_timestamp(raw: str) -> datetime | None:
    """'2026-03-30 01:46:38' → datetime object."""
    raw = raw.strip()
    try:
        return datetime.strptime(raw, "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return None


def parse_raw_file(path: str) -> list[tuple]:
    """
    Read raw WAF log (pipe-delimited, one row per line).
    Returns list of (datetime, ruleGroupId, ruleId, uri, args).
    Expands semicolon-separated rule pairs into separate rows.
    """
    rows = []
    with open(path, encoding="utf-8") as f:
        lines = [l.rstrip("\r\n") for l in f if l.strip()]

    if not lines:
        print("ERROR: raw_input.txt is empty.")
        return rows

    header = lines[0].strip()
    if header != EXPECTED_HEADER:
        print(f"WARNING: Unexpected header:\n  {header[:120]}")

    for line in lines[1:]:
        parts = line.split("|")
        if len(parts) < 13:
            continue

        ts_raw = parts[IDX_TS].strip()
        ts = parse_timestamp(ts_raw)
        if ts is None:
            print(f"  Skipping unrecognised timestamp: {ts_raw}")
            continue

        rg_raw = parts[IDX_RG].strip().replace("AWS#AWS", "AWS")
        ri_raw = parts[IDX_RI].strip().replace("AWS#AWS", "AWS")
        uri    = parts[IDX_URI].strip()
        args   = parts[IDX_ARG].strip() if len(parts) > IDX_ARG else ""

        # Protect against Excel formula injection
        if uri.startswith("="):  uri  = "'" + uri
        if args.startswith("="): args = "'" + args

        # Expand semicolon-separated multi-rule rows
        rg_list = [v.strip() for v in rg_raw.split(";") if v.strip()]
        ri_list = [v.strip() for v in ri_raw.split(";") if v.strip()]
        pair_count = max(len(rg_list), len(ri_list), 1)

        for p in range(pair_count):
            rg = rg_list[p] if p < len(rg_list) else ""
            ri = (ri_list[p] if p < len(ri_list) else "")[:31]
            if rg or ri:
                rows.append((ts, rg, ri, uri, args))

    print(f"  Parsed {len(rows)} data rows from {len(lines)-1} raw lines.")
    return rows


def load_or_create_workbook(path: str) -> Workbook:
    if Path(path).exists():
        wb = load_workbook(path)
        print(f"  Opened existing workbook: {path}")
    else:
        wb = Workbook()
        wb.remove(wb.active)          # remove default Sheet
        print(f"  Creating new workbook: {path}")
    return wb


def daily_report(raw_path: str = RAW_INPUT_FILE,
                 out_path: str = OUTPUT_FILE):
    print("\n=== DailyReport ===")
    rows = parse_raw_file(raw_path)
    if not rows:
        print("  Nothing to process.")
        return

    wb = load_or_create_workbook(out_path)

    # ── ConsolidationSheet ───────────────────────────────────────────────────
    if "ConsolidationSheet" not in wb.sheetnames:
        ws = wb.create_sheet("ConsolidationSheet")
        style_header_row(ws)
        print("  Created ConsolidationSheet.")
    else:
        ws = wb["ConsolidationSheet"]
        print(f"  ConsolidationSheet already has {ws.max_row - 1} rows — appending.")

    # Build a set of existing rows for duplicate check (join as string)
    existing = set()
    for row in ws.iter_rows(min_row=2, values_only=True):
        existing.add("|".join(str(c) if c is not None else "" for c in row))

    added = 0
    for (ts, rg, ri, uri, args) in rows:
        key = "|".join([str(ts), rg, ri, uri, args if args else ""])
        if key in existing:
            continue
        existing.add(key)
        ws.append([ts, rg, ri, uri, args if args else None])
        added += 1

    print(f"  Added {added} new rows to ConsolidationSheet.")

    # Format date column, borders, style
    set_date_format(ws)
    style_data_rows(ws)
    style_header_row(ws)          # re-apply header on top of data rows

    wb.save(out_path)
    print(f"  Saved → {out_path}")


# ══════════════════════════════════════════════════════════════════════════════
# STEP 2 — CreateRuleSheets
# ══════════════════════════════════════════════════════════════════════════════

def create_rule_sheets(out_path: str = OUTPUT_FILE):
    print("\n=== CreateRuleSheets ===")
    wb = load_workbook(out_path)

    if "ConsolidationSheet" not in wb.sheetnames:
        print("  ERROR: ConsolidationSheet not found.")
        return

    ws_con = wb["ConsolidationSheet"]
    headers_row = [c.value for c in ws_con[1]]
    try:
        rule_idx = headers_row.index("Rule")          # 0-based
    except ValueError:
        print("  ERROR: 'Rule' column not found in ConsolidationSheet.")
        return

    # Read all consolidated data
    all_rows = list(ws_con.iter_rows(min_row=2, values_only=True))

    # Group by rule
    rule_groups: dict[str, list] = defaultdict(list)
    for row in all_rows:
        raw_rule = row[rule_idx]
        if not raw_rule:
            continue
        sheet_name = sanitise_sheet_name(str(raw_rule))
        rule_groups[sheet_name].append(row)

    print(f"  Found {len(rule_groups)} unique rules.")

    for sheet_name, data_rows in rule_groups.items():
        if sheet_name not in wb.sheetnames:
            ws = wb.create_sheet(sheet_name)
            style_header_row(ws)
        else:
            ws = wb[sheet_name]

        # Existing rows for duplicate check
        existing = set()
        for row in ws.iter_rows(min_row=2, values_only=True):
            existing.add("|".join(str(c) if c is not None else "" for c in row))

        added = 0
        for row in data_rows:
            key = "|".join(str(c) if c is not None else "" for c in row)
            if key in existing:
                continue
            existing.add(key)
            ws.append(list(row))
            added += 1

        set_date_format(ws)
        style_data_rows(ws)
        style_header_row(ws)
        print(f"  [{sheet_name}] +{added} rows")

    wb.save(out_path)
    print(f"  Saved → {out_path}")


