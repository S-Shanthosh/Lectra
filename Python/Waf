# STEP 3 — GenerateMonthlyReport  (pivot summary → Consolidation sheet)
# ══════════════════════════════════════════════════════════════════════════════

def generate_monthly_report(out_path: str = OUTPUT_FILE):
    """
    Reads ConsolidationSheet, builds a pivot-style summary table:
        Rows    = Rule Set > Rule  (grouped, matching the pivot layout)
        Columns = only days that have data  (no gaps for missing days)
        Values  = count of hits per rule per day
    Writes result to a sheet called 'Consolidation'.
    """
    print("\n=== GenerateMonthlyReport ===")
    wb = load_workbook(out_path)

    if "ConsolidationSheet" not in wb.sheetnames:
        print("  ERROR: ConsolidationSheet not found.")
        return

    ws_con = wb["ConsolidationSheet"]
    headers_row = [c.value for c in ws_con[1]]
    date_idx = 0    # col A = Date
    rg_idx   = 1    # col B = Rule Set
    rule_idx = 2    # col C = Rule

    # ── collect all data ─────────────────────────────────────────────────────
    counts: dict[tuple, dict[str, int]] = defaultdict(lambda: defaultdict(int))
    # counts[(rule_set, rule)][date_str] += 1

    all_dates_seen: set[str] = set()
    month_name = ""
    year_2d    = ""

    for row in ws_con.iter_rows(min_row=2, values_only=True):
        dt_val  = row[date_idx]
        rg_val  = row[rg_idx]  or ""
        rule_val= row[rule_idx] or ""

        if dt_val is None:
            continue

        # dt_val is a datetime object (openpyxl reads Excel datetime cells directly)
        if isinstance(dt_val, datetime):
            dt = dt_val
        elif isinstance(dt_val, (int, float)):
            # Excel serial fallback
            from datetime import timedelta
            dt = datetime(1899, 12, 30) + timedelta(days=dt_val)
        else:
            continue

        date_str = dt.strftime("%d/%m/%y")          # e.g. "01/05/26"
        all_dates_seen.add(date_str)

        if not month_name:
            month_name = dt.strftime("%B")           # e.g. "May"
            year_2d    = dt.strftime("%y")

        counts[(rg_val, rule_val)][date_str] += 1

    if not counts:
        print("  No data found in ConsolidationSheet.")
        return

    # ── sorted unique dates that actually have data ───────────────────────────
    sorted_dates = sorted(all_dates_seen,
                          key=lambda s: datetime.strptime(s, "%d/%m/%y"))

    # ── sorted rule pairs: by rule set then rule ──────────────────────────────
    # Mimic pivot layout: RuleSet header row, then its child Rules indented
    rule_sets_ordered = sorted(set(k[0] for k in counts))

    # Build rows: (label, is_ruleset_header, counts_dict)
    pivot_rows: list[tuple] = []
    grand_total_by_date: dict[str, int] = defaultdict(int)

    for rs in rule_sets_ordered:
        rs_totals: dict[str, int] = defaultdict(int)
        child_rows = []

        for rule in sorted(set(k[1] for k in counts if k[0] == rs)):
            rule_counts = counts[(rs, rule)]
            for d, v in rule_counts.items():
                rs_totals[d] += v
                grand_total_by_date[d] += v
            child_rows.append((rule, rule_counts))

        pivot_rows.append((rs, True, dict(rs_totals)))    # rule set header
        for (rule, rc) in child_rows:
            pivot_rows.append((rule, False, dict(rc)))    # child rule

    # ── build/replace Consolidation sheet ────────────────────────────────────
    if "Consolidation" in wb.sheetnames:
        del wb["Consolidation"]
    ws2 = wb.create_sheet("Consolidation")

    # Header row: WAF US PRD May | May 1 | May 2 | ... | Grand Total
    header: list = [f"WAF US PRD {month_name}"]
    for ds in sorted_dates:
        day_num = int(ds[:2])
        header.append(f"{month_name[:3]} {day_num}")
    header.append("Grand Total")

    # Style header
    green_fill = PatternFill("solid", fgColor=GREEN_PIVOT)
    bold_font  = Font(bold=True, color=BLACK)
    centre     = Alignment(horizontal="center", vertical="center")
    b          = thin_border()

    for col_idx, val in enumerate(header, 1):
        cell = ws2.cell(row=1, column=col_idx, value=val)
        cell.fill      = green_fill
        cell.font      = bold_font
        cell.alignment = centre
        cell.border    = b
        cell.number_format = "@"    # text

    ws2.row_dimensions[1].height = 26.25
    ws2.column_dimensions["A"].width = 30.7   # ≈215px
    ws2.freeze_panes = "A2"

    # ── data rows ─────────────────────────────────────────────────────────────
    wrap_align = Alignment(wrap_text=True)
    for (label, is_rs, day_counts) in pivot_rows:
        row_total = sum(day_counts.values())
        row_data  = [label]
        for ds in sorted_dates:
            v = day_counts.get(ds)
            row_data.append(v if v else None)
        row_data.append(row_total if row_total else None)

        row_num = ws2.max_row + 1
        for col_idx, val in enumerate(row_data, 1):
            cell = ws2.cell(row=row_num, column=col_idx, value=val)
            cell.border    = b
            cell.alignment = wrap_align
            if is_rs:
                cell.font = Font(bold=True)

    # Grand Total row (green)
    gt_row = ["Grand Total"]
    grand_total = 0
    for ds in sorted_dates:
        v = grand_total_by_date.get(ds, 0)
        gt_row.append(v if v else None)
        grand_total += v
    gt_row.append(grand_total if grand_total else None)

    gt_row_num = ws2.max_row + 1
    for col_idx, val in enumerate(gt_row, 1):
        cell = ws2.cell(row=gt_row_num, column=col_idx, value=val)
        cell.fill      = green_fill
        cell.font      = bold_font
        cell.alignment = centre
        cell.border    = b

    # Auto-fit remaining columns (approximate)
    for col_idx in range(2, len(header) + 1):
        ws2.column_dimensions[get_column_letter(col_idx)].width = 8

    # ── rename ConsolidationSheet → ConsolidationSheet-old ───────────────────
    wb["ConsolidationSheet"].title = "ConsolidationSheet-old"

    # ── sheet order: ConsolidationSheet-old at pos 1, Consolidation at pos 2 ─
    sheet_names = wb.sheetnames
    sheets = {name: wb[name] for name in sheet_names}
    ordered = ["ConsolidationSheet-old", "Consolidation"] + \
              [n for n in sheet_names if n not in ("ConsolidationSheet-old", "Consolidation")]
    for i, name in enumerate(ordered):
        wb.move_sheet(name, offset=i - wb.index(wb[name]))

    wb.save(out_path)
    print(f"  Written Consolidation sheet — {len(sorted_dates)} date columns, "
          f"{len(pivot_rows)} rule rows.")
    print(f"  Grand Total: {grand_total} hits")
    print(f"  Saved → {out_path}")


